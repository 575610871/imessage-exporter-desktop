<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>iMessage Exporter Desktop Suoh Edition</AssemblyName>
    <RootNamespace>IMessageExporterDesktopSuohEdition</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\Suoh.ico')">Assets\Suoh.ico</ApplicationIcon>
    <Product>$(AssemblyName)</Product>
    <Title>$(AssemblyName)</Title>
    <Copyright>GPL-3.0-or-later; includes ReagentX/imessage-exporter</Copyright>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\Suoh.Model\Suoh.Model.csproj" /></ItemGroup>
</Project>
