<Window x:Class="Suoh.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="苏芳 · iMessage — 便携版"
        Width="1120" Height="820" MinWidth="1" MinHeight="1" WindowStartupLocation="Manual"
        Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontSize="14"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        SizeChanged="OnLayoutSizeChanged" Closing="OnClosing" PreviewKeyDown="OnShortcut">
  <Grid x:Name="Surface">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel x:Name="Header" Margin="24,18,24,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Width="40" Height="40" Background="{StaticResource Suoh}" CornerRadius="12" Margin="0,0,12,0">
          <Viewbox Margin="10"><Path Fill="White" Data="M 2,1 L 18,1 Q 22,1 22,5 L 22,14 Q 22,18 18,18 L 10,18 L 4,23 L 5,18 L 2,18 Q -1,18 -1,14 L -1,5 Q -1,1 2,1 Z" /></Viewbox>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="苏芳 · iMessage" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="SUOH  /  YOUR CONVERSATIONS, KEPT." FontSize="9" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
        </StackPanel>
        <Button Grid.Column="2" Content="使用指南" Click="ShowGuide" Padding="12,6" MinHeight="32" VerticalAlignment="Center" />
      </Grid>
      <StackPanel x:Name="Hero" Margin="0,20,0,14">
        <TextBlock Text="把对话，好好收藏。" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="从 iPhone 本地备份，导出可以随时翻阅的聊天记录。" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button x:Name="SettingsTab" Content="导出设置" Click="ShowSettings" Background="{StaticResource Wash}" BorderBrush="{StaticResource Wash}" Foreground="{StaticResource Suoh}" Margin="0,0,8,0" />
        <Button x:Name="LogsTab" Content="任务日志" Click="ShowLogs" Background="Transparent" BorderBrush="Transparent" />
        <TextBlock x:Name="PortableBadge" Text="免安装 · 本地处理" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="18,0,0,0" />
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="1" x:Name="Workspace" Margin="24,0,24,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="AsideColumn" Width="300" /></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel x:Name="Form">
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="01   选择备份" Style="{StaticResource SectionTitle}" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="SourceInput" AutomationProperties.Name="iPhone 备份根目录" ToolTip="包含 Manifest.plist 和 Manifest.db 的文件夹" />
              <Button Grid.Column="1" Content="浏览…" Click="PickSource" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="支持 Apple Devices / iTunes 的本地备份；不能直接读取连接的手机。" Style="{StaticResource Hint}" Margin="0,8,0,0" />
            <WrapPanel Margin="0,10,0,0">
              <Button x:Name="FindButton" Content="查找本机备份" Click="FindBackups" Padding="12,6" Margin="0,0,8,0" />
              <Button x:Name="DiagnoseButton" Content="检查备份" Click="Diagnose" Padding="12,6" />
            </WrapPanel>
            <ComboBox x:Name="BackupChoices" Visibility="Collapsed" SelectionChanged="ChooseBackup" Margin="0,10,0,0" AutomationProperties.Name="查找到的备份" />
          </StackPanel></Border>

          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="02   保存到哪里" Style="{StaticResource SectionTitle}" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="OutputInput" AutomationProperties.Name="导出位置" />
              <Button Grid.Column="1" Content="浏览…" Click="PickOutput" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="每次自动新建独立文件夹，已有导出不会被覆盖。" Style="{StaticResource Hint}" Margin="0,8,0,0" />
          </StackPanel></Border>

          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="03   导出方式" Style="{StaticResource SectionTitle}" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <RadioButton x:Name="HtmlChoice" GroupName="Format" IsChecked="True" Style="{StaticResource FormatChoice}" Margin="0,0,6,0" AutomationProperties.Name="HTML 网页格式" Checked="FormatChanged">
                <StackPanel><TextBlock Text="HTML 网页" FontWeight="SemiBold" /><TextBlock Text="在浏览器里翻阅" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
              </RadioButton>
              <RadioButton x:Name="TextChoice" Grid.Column="1" GroupName="Format" Style="{StaticResource FormatChoice}" Margin="6,0,0,0" AutomationProperties.Name="TXT 纯文本格式" Checked="FormatChanged">
                <StackPanel><TextBlock Text="TXT 文本" FontWeight="SemiBold" /><TextBlock Text="便于检索和归档" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
              </RadioButton>
            </Grid>
            <TextBlock Text="照片与附件" Margin="0,16,0,8" FontWeight="SemiBold" />
            <ComboBox x:Name="MediaChoice" SelectedIndex="0" SelectionChanged="MediaChanged" AutomationProperties.Name="附件处理方式">
              <ComboBoxItem Content="保留原文件 · 推荐" /><ComboBoxItem Content="不复制附件" />
              <ComboBoxItem Content="转换图片 · 需要 ImageMagick" /><ComboBoxItem Content="转换全部媒体 · 需要 ImageMagick + FFmpeg" />
            </ComboBox>
            <TextBlock x:Name="MediaHint" Text="复制原始照片、视频等附件，不需要额外工具。HEIC 等格式可能需要对应查看器。" Style="{StaticResource Hint}" Margin="0,8,0,0" />
          </StackPanel></Border>

          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="备份密码" FontWeight="SemiBold" Margin="0,0,0,8" />
            <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="加密备份密码，可选" />
            <TextBlock Text="仅加密备份需要。不是 Apple ID 密码；只传给本地引擎，不保存到设置或命令行。" Style="{StaticResource Hint}" Margin="0,8,0,0" />
          </StackPanel></Border>

          <Border Style="{StaticResource Card}"><Expander x:Name="Advanced" Header="更多选项 · 日期、会话与显示" Padding="0">
            <StackPanel Margin="0,14,0,0">
              <TextBlock Text="日期范围（留空表示不限）" FontWeight="SemiBold" />
              <WrapPanel Margin="0,8,0,0">
                <StackPanel Width="190" Margin="0,0,12,10"><TextBlock Text="从这一天开始" Style="{StaticResource Hint}" /><DatePicker x:Name="FromInput" AutomationProperties.Name="开始日期" MinHeight="34" /></StackPanel>
                <StackPanel Width="190" Margin="0,0,0,10"><TextBlock Text="到这一天之前（不含当天）" Style="{StaticResource Hint}" /><DatePicker x:Name="BeforeInput" AutomationProperties.Name="结束日期，不含当天" MinHeight="34" /></StackPanel>
              </WrapPanel>
              <TextBlock Text="指定会话（可选）" Margin="0,6,0,8" FontWeight="SemiBold" />
              <TextBox x:Name="ConversationInput" AutomationProperties.Name="会话筛选" />
              <TextBlock Text="填写手机号、邮箱或群聊名称；多个条件用英文逗号分隔。留空导出全部。" Style="{StaticResource Hint}" Margin="0,6,0,12" />
              <TextBlock Text="记录中“我”的名字（可选）" Margin="0,0,0,8" FontWeight="SemiBold" />
              <TextBox x:Name="NameInput" AutomationProperties.Name="我的名字" />
              <CheckBox x:Name="CallerIdOption" Content="用账户号码 / 邮箱代替自定义名字" Checked="CallerIdChanged" Unchecked="CallerIdChanged" />
              <CheckBox x:Name="EagerOption" Content="HTML 中立即加载图片" />
              <CheckBox x:Name="TimestampOption" Content="使用消息时间作为导出文件时间" />
            </StackPanel>
          </Expander></Border>
          <WrapPanel Margin="0,0,0,16">
            <CheckBox x:Name="RememberOption" Content="记住目录和导出格式" Unchecked="ForgetPreferences" />
            <CheckBox x:Name="OpenAfterOption" Content="完成后打开文件夹" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>

      <Border x:Name="LogPage" Grid.ColumnSpan="2" Visibility="Collapsed" Style="{StaticResource Card}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="保存日志…" Click="SaveLog" /><TextBlock Text="任务日志" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
          <TextBox x:Name="LogOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" AutomationProperties.Name="导出任务日志" />
          <TextBlock Grid.Row="2" Text="日志可能包含目录和联系人信息。分享前请检查；本程序不会自动上传日志。" Style="{StaticResource Hint}" Margin="0,10,0,0" />
        </Grid>
      </Border>

      <ScrollViewer x:Name="Aside" Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Background="{StaticResource Suoh}" CornerRadius="14" Padding="24"><StackPanel>
            <TextBlock Text="留住那些，&#10;舍不得删的日常。" FontSize="24" Foreground="White" FontWeight="SemiBold" LineHeight="36" />
            <TextBlock Text="每一句问候，都值得被好好保存。" Foreground="#F2CDD8" FontSize="12" Margin="0,12,0,28" />
            <Border Background="#B24E68" CornerRadius="12,12,12,2" Padding="14" Margin="0,0,24,12"><TextBlock Text="今天也有好好吃饭吗？" Foreground="White" FontSize="13" /></Border>
            <Border Background="#FFF9F5" CornerRadius="12,12,2,12" Padding="14" Margin="24,0,0,12"><TextBlock Text="有呀。等下给你打电话。" Foreground="#792139" FontSize="13" /></Border>
            <TextBlock Text="示例对话 · 非真实聊天数据" Foreground="#F2CDD8" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0" />
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,16"><StackPanel>
            <TextBlock Text="开始之前" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="1. 用 Apple Devices 或 iTunes 完成本地备份。&#10;&#10;2. 选择设备对应的备份目录。&#10;&#10;3. 留出足够空间，开始导出。" Style="{StaticResource Hint}" />
            <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,14" />
            <TextBlock Text="引擎来自 ReagentX / imessage-exporter；苏芳是独立重写的 Windows 图形界面。" Style="{StaticResource Hint}" />
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="White" Padding="24,12">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
          <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0" />
          <TextBlock x:Name="StatusText" Text="准备就绪 · 选择备份后即可开始" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <ProgressBar x:Name="Activity" Height="3" Foreground="{StaticResource Suoh}" Background="{StaticResource Wash}" BorderThickness="0" />
            <TextBlock x:Name="FooterNote" Text="苏芳 0.2.0 · 便携版" Style="{StaticResource Hint}" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="OpenResultButton" Content="打开结果" Click="OpenResult" IsEnabled="False" Margin="0,0,8,0" Padding="12,9" />
            <Button x:Name="CancelButton" Content="取消" Click="CancelJob" IsEnabled="False" Margin="0,0,8,0" Padding="12,9" />
            <Button x:Name="ExportButton" Content="开始导出  →" Style="{StaticResource Primary}" Click="Export" Padding="22,9" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
