<Application x:Class="IMessageExporterDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#1677FF" />
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0B5ED7" />
            <SolidColorBrush x:Key="TextBrush" Color="#172033" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />
            <SolidColorBrush x:Key="BorderBrush" Color="#D9E1EC" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
