<Window x:Class="IMessageExporterDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iMessage Exporter Desktop"
        Width="980"
        Height="860"
        MinWidth="820"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderBrush" Value="#E3E9F2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TextInputStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PasswordInputStyle" TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ComboInputStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#24324A" />
            <Setter Property="BorderBrush" Value="#C9D3E2" />
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FFF4F3" />
            <Setter Property="Foreground" Value="#C4322C" />
            <Setter Property="BorderBrush" Value="#FDA29B" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,4,20,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1677FF">
            <Grid Margin="28,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="iMessage Exporter Desktop"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="SemiBold" />
                    <TextBlock Text="不用命令行，也能安全导出本地 iPhone 信息备份"
                               Foreground="#EAF3FF"
                               FontSize="14"
                               Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#2AFFFFFF"
                        CornerRadius="18"
                        Padding="13,7"
                        VerticalAlignment="Center">
                    <TextBlock Text="仅在本机处理 · 不上传数据"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,10">

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="1  选择 iPhone 备份"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="请选择包含 Manifest.plist 的设备备份根目录，而不是里面的数据库文件。"
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BackupPathTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource TextInputStyle}"
                                     Margin="0,0,10,0"
                                     ToolTip="Apple Devices 或 iTunes 的设备备份目录" />
                            <Button x:Name="BrowseBackupButton"
                                    Grid.Column="1"
                                    Content="浏览…"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseBackupButton_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                            <Button x:Name="DetectBackupsButton"
                                    Content="自动查找备份"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="DetectBackupsButton_Click"
                                    Margin="0,0,10,0" />
                            <TextBlock Text="支持 Apple Devices 与桌面版 iTunes 的常见备份位置"
                                       Style="{StaticResource HintStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ListBox x:Name="DetectedBackupsList"
                                 MaxHeight="120"
                                 Background="#F8FAFD"
                                 BorderBrush="#E3E9F2"
                                 SelectionChanged="DetectedBackupsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,5">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding Path}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="2  选择导出位置"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputBaseTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource TextInputStyle}"
                                     Margin="0,0,10,0" />
                            <Button x:Name="BrowseOutputButton"
                                    Grid.Column="1"
                                    Content="浏览…"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputButton_Click" />
                        </Grid>
                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox x:Name="NewSubfolderCheckBox"
                                      Content="每次新建带日期的文件夹（推荐）"
                                      IsChecked="True" />
                            <CheckBox x:Name="OpenWhenDoneCheckBox"
                                      Content="完成后打开文件夹"
                                      IsChecked="True" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="3  设置导出内容"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="文件格式" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="FormatComboBox"
                                          Style="{StaticResource ComboInputStyle}"
                                          SelectionChanged="FormatComboBox_SelectionChanged" />
                                <TextBlock Text="HTML 保留气泡、图片和对话结构；TXT 适合纯文本检索。"
                                           Style="{StaticResource HintStyle}"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="附件处理" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="AttachmentModeComboBox"
                                          Style="{StaticResource ComboInputStyle}" />
                                <TextBlock Text="“原样复制”不需要额外软件，最稳定。"
                                           Style="{StaticResource HintStyle}"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="开始日期（包含当天）"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="StartDateCheckBox"
                                              Content="启用"
                                              Click="DateCheckBox_Click" />
                                    <DatePicker x:Name="StartDatePicker"
                                                Width="170"
                                                IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="结束日期（不包含当天）"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="EndDateCheckBox"
                                              Content="启用"
                                              Click="DateCheckBox_Click" />
                                    <DatePicker x:Name="EndDatePicker"
                                                Width="170"
                                                IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="联系人筛选（可选）"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="ConversationFilterTextBox"
                                         Style="{StaticResource TextInputStyle}" />
                                <TextBlock Text="可输入姓名、电话或邮箱；多个条件用英文逗号分隔。"
                                           Style="{StaticResource HintStyle}"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="“我”的显示名称（可选）"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="CustomNameTextBox"
                                         Style="{StaticResource TextInputStyle}" />
                                <CheckBox x:Name="UseCallerIdCheckBox"
                                          Content="使用备份中的账户号码/邮箱"
                                          Checked="UseCallerIdCheckBox_CheckedChanged"
                                          Unchecked="UseCallerIdCheckBox_CheckedChanged" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="加密备份密码（仅在需要时填写）"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <PasswordBox x:Name="BackupPasswordBox"
                                             Style="{StaticResource PasswordInputStyle}" />
                                <TextBlock Text="密码不会保存，也不会放入命令行；任务结束后输入框会自动清空。"
                                           Style="{StaticResource HintStyle}"
                                           Margin="0,5,0,12" />
                                <WrapPanel>
                                    <CheckBox x:Name="NoLazyCheckBox"
                                              Content="HTML 便于打印为 PDF（关闭图片懒加载）" />
                                    <CheckBox x:Name="UseMessageTimesCheckBox"
                                              Content="用消息日期标记导出文件" />
                                    <CheckBox x:Name="IgnoreDiskWarningCheckBox"
                                              Content="忽略磁盘空间警告（不推荐）"
                                              Foreground="#B42318" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="4  开始处理"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0" />
                            <Border x:Name="StatusBorder"
                                    Grid.Column="1"
                                    Background="#EEF4FF"
                                    CornerRadius="12"
                                    Padding="11,5">
                                <TextBlock x:Name="StatusTextBlock"
                                           Text="准备就绪"
                                           Foreground="#175CD3"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ProgressBar x:Name="OperationProgressBar"
                                     Height="7"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Margin="0,0,0,12" />

                        <TextBox x:Name="LogTextBox"
                                 Height="175"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#101828"
                                 Foreground="#D0D5DD"
                                 BorderThickness="0"
                                 Padding="12"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Text="准备就绪。请选择备份与导出位置。" />

                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="StartExportButton"
                                    Content="开始导出"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="StartExportButton_Click"
                                    Margin="0,0,10,0"
                                    MinWidth="120" />
                            <Button x:Name="DiagnosticsButton"
                                    Content="运行诊断"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="DiagnosticsButton_Click"
                                    Margin="0,0,10,0" />
                            <Button x:Name="CancelButton"
                                    Content="取消"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="CancelButton_Click"
                                    Margin="0,0,10,0"
                                    IsEnabled="False" />
                            <Button x:Name="OpenOutputButton"
                                    Content="打开导出文件夹"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenOutputButton_Click"
                                    IsEnabled="False" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E3E9F2"
                BorderThickness="0,1,0,0">
            <Grid Margin="28,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="社区 GUI · 导出核心：ReagentX/imessage-exporter · GPL-3.0-or-later"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="查看上游项目"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OpenUpstreamButton_Click"
                        MinHeight="30"
                        Padding="10,4" />
            </Grid>
        </Border>
    </Grid>
</Window>
