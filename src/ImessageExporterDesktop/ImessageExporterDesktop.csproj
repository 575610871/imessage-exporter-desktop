<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>iMessage Exporter Desktop</AssemblyName>
    <RootNamespace>IMessageExporterDesktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\App.ico')">Assets\App.ico</ApplicationIcon>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <Product>iMessage Exporter Desktop</Product>
    <Company>Community build</Company>
    <Copyright>GPL-3.0-or-later community build</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ImessageExporterDesktop.Core\ImessageExporterDesktop.Core.csproj" />
  </ItemGroup>
</Project>
